      "dialogue": {
        "title": "Devant l'arrêt de bus",
        "lines": [
          {
            "name": "Magloire",
            "tr": "Affedersiniz, saat kaç oldu?",
            "fr": "Excusez-moi, quelle heure est-il ?"
          },
          {
            "name": "Passant",
            "tr": "Saat on buçuk oldu.",
            "fr": "Il est dix heures et demie."
          },
          {
            "name": "Magloire",
            "tr": "Otobüs ne zaman geliyor?",
            "fr": "Quand est-ce que le bus arrive ?"
          },
          {
            "name": "Passant",
            "tr": "On beşte geliyor. Siz kaç yaşındasınız?",
            "fr": "Il arrive à dix heures cinq. Vous avez quel âge ?"
          },
          {
            "name": "Magloire",
            "tr": "Ben yirmi yaşındayım. Neden sordunuz?",
            "fr": "J'ai vingt ans. Pourquoi cette question ?"
          },
          {
            "name": "Passant",
            "tr": "Öğrenci bileti var mı diye. Gençlere indirim var!",
            "fr": "Pour savoir si vous avez un billet étudiant. Il y a une réduction pour les jeunes !"
          }
        ]
      },
      "vocab": [
        {
          "tr": "bir … on",
