      ],
      "quiz": [
        {
          "q": "Comment dire « le livre que j'ai acheté » ?",
          "options": [
            "aldığım kitap",
            "alan kitap",
            "alacağım kitap"
          ],
          "a": 0,
          "why": "Le participe -dik avec le possessif de la première personne donne aldığım."
        },
        {
          "q": "Que signifie « çalışan adam » ?",
          "options": [
            "l'homme qui travaille",
            "l'homme qui a travaillé",
            "l'homme qui travaillera"
          ],
          "a": 0,
          "why": "-en/-an est le participe présent : çalışan = qui travaille."
        }
      ]
    },
    {
      "id": "u12",
      "num": 12,
      "level": "B1",
      "title": "Le passé indéfini",
      "goal": "Employer -miş, rapporter une information non vérifiée et situer avec les postpositions.",
      "blocks": [
        {
          "t": "p",
          "text": "Le suffixe <b>-miş / -mış / -muş / -müş</b> marque un passé <b>indirect</b> : information rapportée, découverte, conte ou événement dont on n'a pas été témoin. En français, on le rend par « il paraît que », « apparemment » ou « il se trouve que »."
        },
        {
          "t": "table",
          "caption": "gelmek au passé indéfini",
          "head": [
            "Personne",
            "Forme",
            "Sens"
          ],
          "rows": [
            [
              "ben",
              "<tur>gelmişim</tur>",
              "il paraît que je suis venu"
            ],
            [
              "sen",
              "<tur>gelmişsin</tur>",
              "il paraît que tu es venu"
            ],
            [
              "o",
              "<tur>gelmiş</tur>",
              "il / elle serait venu(e)"
            ],
            [
              "biz",
              "<tur>gelmişiz</tur>",
              "nous serions venus"
            ],
            [
              "siz",
              "<tur>gelmişsiniz</tur>",
              "vous seriez venus"
            ],
            [
              "onlar",
              "<tur>gelmişler</tur>",
              "ils / elles seraient venus"
            ]
          ]
        },
        {
          "t": "note",
          "kind": "info",
          "tag": "Négation et question",
          "text": "Négatif : <tur>gelmemişim</tur> (il paraît que je ne suis pas venu). Question : <tur>gelmiş mi?</tur> (Serait-il venu ?)."
        },
        {
          "t": "p",
          "text": "Les <b>postpositions de lieu</b> se construisent avec le génitif : <tur>masanın üstünde</tur> (sur la table), <tur>kapının yanında</tur> (à côté de la porte), <tur>evin önünde</tur> (devant la maison), <tur>arabanın arkasında</tur> (derrière la voiture)."
        },
        {
          "t": "ex",
          "items": [
            {
              "tr": "Ali eve gelmiş.",
              "fr": "Apparemment, Ali est rentré à la maison."
            },
            {
              "tr": "Ayşe yeni bir iş bulmuş.",
              "fr": "Il paraît qu'Ayşe a trouvé un nouveau travail."
            },
            {
              "tr": "Kitabım masanın üstünde.",
              "fr": "Mon livre est sur la table."
            },
            {
              "tr": "Duyduğuma göre hava yarın düzelecek.",
              "fr": "D'après ce que j'ai entendu, le temps va s'améliorer demain."
            }
          ]
        },
        {
          "t": "note",
          "kind": "tip",
          "tag": "Ne pas confondre",
          "text": "<tur>Geldi</tur> = je l'ai vu venir, j'en suis témoin. <tur>Gelmiş</tur> = on me l'a dit, je le déduis. Le choix du suffixe change la source de l'information."
        }
      ],
