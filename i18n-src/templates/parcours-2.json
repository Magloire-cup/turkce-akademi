      "quiz": [
        {
          "q": "Comment dire « J'ai vu la maison » ?",
          "options": [
            "Evi gördüm.",
            "Ev gördüm.",
            "Eve gördüm."
          ],
          "a": 0,
          "why": "La maison est un objet défini : ev + i = evi, placé avant le verbe."
        },
        {
          "q": "Quel est le pronom objet de « ben » ?",
          "options": [
            "beni",
            "bana",
            "benim"
          ],
          "a": 0,
          "why": "L'accusatif de ben est beni ; bana est le datif et benim le génitif."
        }
      ]
    },
    {
      "id": "u10",
      "num": 10,
      "level": "A2",
      "title": "Habitudes et politesse",
      "goal": "Parler de ses habitudes, faire une demande polie et évoquer le passé récurrent.",
      "blocks": [
        {
          "t": "p",
          "text": "Le <b>présent simple</b> (ou présent d'habitude) se forme avec <b>-ir / -ır / -ur / -ür</b>, ou simplement <b>-r</b> après une voyelle. Il décrit ce qui se répète, une vérité générale ou un goût."
        },
        {
          "t": "table",
          "caption": "gelmek (venir) au présent simple",
          "head": [
            "Personne",
            "Affirmatif",
            "Négatif"
          ],
          "rows": [
            [
              "ben",
              "<tur>gelirim</tur>",
              "<tur>gelmem</tur>"
            ],
            [
              "sen",
              "<tur>gelirsin</tur>",
              "<tur>gelmezsin</tur>"
            ],
            [
              "o",
              "<tur>gelir</tur>",
              "<tur>gelmez</tur>"
            ],
            [
              "biz",
              "<tur>geliriz</tur>",
              "<tur>gelmeyiz</tur>"
            ],
            [
              "siz",
              "<tur>gelirsiniz</tur>",
              "<tur>gelmezsiniz</tur>"
            ],
            [
              "onlar",
              "<tur>gelirler</tur>",
              "<tur>gelmezler</tur>"
            ]
          ]
        },
        {
          "t": "p",
          "text": "Le <b>passé d'habitude</b> ajoute <b>-erdi / -ardı</b> : <tur>gelirdim</tur> (je venais, j'avais l'habitude de venir). Il sert aux souvenirs répétés : <tur>Çocukken her yaz köye giderdik.</tur>"
        },
        {
          "t": "p",
          "text": "Pour une demande polie, on utilise le présent simple + <tur>mi</tur> : <tur>Bana yardım eder misiniz?</tur> (Pourriez-vous m'aider ?), <tur>Bir dakika bekler misiniz?</tur> (Pourriez-vous patienter un instant ?). Pour offrir : <tur>Çay ister misiniz?</tur> (Voulez-vous du thé ?)."
        },
        {
          "t": "ex",
          "items": [
            {
              "tr": "Her sabah erken kalkarım.",
              "fr": "Je me lève tôt chaque matin."
            },
            {
              "tr": "Genellikle otobüsle işe giderim.",
              "fr": "Je vais généralement au travail en bus."
            },
            {
              "tr": "Çocukken her yaz köye giderdik.",
              "fr": "Enfant, nous allions au village chaque été."
            },
            {
              "tr": "Bana yardım eder misin?",
              "fr": "Peux-tu m'aider ?"
            }
          ]
        },
        {
          "t": "note",
          "kind": "tip",
          "tag": "Fréquence",
          "text": "<tur>her zaman</tur> (toujours), <tur>genellikle</tur> (généralement), <tur>sık sık</tur> (souvent), <tur>bazen</tur> (parfois), <tur>nadiren</tur> (rarement), <tur>asla</tur> (jamais)."
        }
      ],
      "vocab": [
        [
          "kalkmak",
          "se lever"
        ],
        [
          "yürümek",
          "marcher"
        ],
        [
          "otobüs",
          "bus"
        ],
        [
          "erken",
          "tôt"
        ],
        [
          "geç",
          "tard"
        ],
        [
          "her gün",
          "chaque jour"
        ],
        [
          "sık sık",
          "souvent"
        ],
        [
          "bazen",
          "parfois"
        ],
        [
          "asla",
          "jamais"
        ],
        [
          "beklemek",
          "attendre"
        ]
      ],
      "quiz": [
        {
          "q": "Comment dit-on « je me lève tôt » ?",
          "options": [
            "Erken kalkarım",
            "Erken kalkıyorum",
            "Erken kalktım"
          ],
          "a": 0,
          "why": "Une habitude se rend au présent simple : kalk- + -ar + -ım = kalkarım."
        },
        {
          "q": "Que signifie « giderdik » ?",
          "options": [
            "nous allions (habituellement)",
            "nous irons",
            "nous sommes allés"
          ],
          "a": 0,
          "why": "-erdi/-ardı exprime une habitude passée : giderdik = nous avions l'habitude d'aller."
        }
      ]
    },
    {
      "id": "u11",
      "num": 11,
      "level": "B1",
      "title": "Relier les idées",
      "goal": "Former des relatives avec les participes -en, -dik et -ecek, et rapporter des propos.",
      "blocks": [
        {
          "t": "p",
          "text": "Le turc relie les idées avec des <b>participes</b> placés avant le nom, sans pronom relatif séparé. Le suffixe <b>-en / -an</b> correspond à « qui » au présent : <tur>çalışan adam</tur> (l'homme qui travaille)."
        },
        {
          "t": "table",
          "caption": "Trois participes utiles",
          "head": [
            "Forme",
            "Exemple",
            "Sens"
          ],
          "rows": [
            [
              "-en / -an",
              "<tur>bekleyen kadın</tur>",
              "la femme qui attend"
            ],
            [
              "-dik / -dık",
              "<tur>aldığım kitap</tur>",
              "le livre que j'ai acheté"
            ],
            [
              "-ecek / -acak",
              "<tur>gideceğimiz otel</tur>",
              "l'hôtel où nous irons"
            ]
          ]
        },
        {
          "t": "note",
          "kind": "info",
          "tag": "Possessif dans le participe",
          "text": "Avec -dik et -ecek, le suffixe possessif indique qui fait l'action : <tur>aldığım</tur> (que j'ai acheté), <tur>aldığın</tur> (que tu as acheté), <tur>aldığı</tur> (qu'il a acheté), <tur>aldığımız</tur> (que nous avons acheté)."
        },
        {
          "t": "p",
          "text": "Pour rapporter des paroles, on peut citer directement : <tur>Ali « Yarın geleceğim » dedi.</tur> Ou intégrer la proposition : <tur>Ali yarın geleceğini söyledi.</tur> (Ali a dit qu'il viendrait demain.)."
        },
        {
          "t": "ex",
          "items": [
            {
              "tr": "Kütüphanede çalışan öğrenci benim arkadaşım.",
              "fr": "L'étudiant qui travaille à la bibliothèque est mon ami."
            },
            {
              "tr": "Dün aldığım kitap çok güzel.",
              "fr": "Le livre que j'ai acheté hier est très beau."
            },
            {
              "tr": "Gideceğimiz otel deniz kenarında.",
              "fr": "L'hôtel où nous irons est au bord de la mer."
            },
            {
              "tr": "Ali yarın geleceğini söyledi.",
              "fr": "Ali a dit qu'il viendrait demain."
            }
          ]
        },
        {
          "t": "note",
          "kind": "tip",
          "tag": "Méthode",
          "text": "Pour traduire une relative française, commence par le nom, puis place l'action au participe devant lui, et ajoute le possessif si nécessaire. <tur>Le train qui arrive</tur> → <tur>gelen tren</tur>."
        }
      ],
