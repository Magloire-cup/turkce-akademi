          "tomorrow"
        ],
        [
          "dün",
          "yesterday"
        ]
      ],
      "quiz": [
        {
          "q": "Which form means «to school» (destination)?",
          "options": [
            "okulda",
            "okula",
            "okuldan"
          ],
          "a": 1,
          "why": "The destination uses the dative -a: okul + a = okula."
        },
        {
          "q": "How do you say «from the house»?",
          "options": [
            "evde",
            "eve",
            "evden"
          ],
          "a": 2,
          "why": "The ablative -den indicates origin: ev + den = evden."
        }
      ]
    },
    {
      "id": "u4",
      "num": 4,
      "level": "A1",
      "title": "Describing and finding your way",
      "goal": "Use adjectives, colours, the imperative and directions.",
      "blocks": [
        {
          "t": "p",
          "text": "Titles come after the first name: <tur>Ali Bey</tur> (Mr Ali), <tur>Ayşe Hanım</tur> (Mrs Ayşe). Adverbs of frequency generally come before the verb: <tur>her zaman</tur> (always), <tur>genellikle</tur> (generally), <tur>sık sık</tur> (often), <tur>bazen</tur> (sometimes), <tur>hiç</tur> (never)."
        },
        {
          "t": "table",
          "caption": "The imperative",
          "head": [
            "Infinitive",
            "Informal (sen)",
            "Polite (siz)",
            "Polite negative"
          ],
          "rows": [
            [
              "<tur>gelmek</tur>",
              "<tur>gel</tur>",
              "<tur>gelin</tur>",
              "<tur>gelmeyin</tur>"
            ],
            [
              "<tur>gitmek</tur>",
              "<tur>git</tur>",
              "<tur>gidin</tur>",
              "<tur>gitmeyin</tur>"
            ],
            [
              "<tur>okumak</tur>",
              "<tur>oku</tur>",
              "<tur>okuyun</tur>",
              "<tur>okumayın</tur>"
            ]
          ]
        },
        {
          "t": "table",
