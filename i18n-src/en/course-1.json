          ],
          "a": 1,
          "exp": "ad (name) + -ın (your) + ne (what): « your name, what? »."
        },
        {
          "q": "With « o » (he/she), the suffix for « to be » is…",
          "opts": [
            "-dir, always required",
            "often nothing at all",
            "-sin",
            "-lar"
          ],
          "a": 1,
          "exp": "O doktor is enough. The suffix -dir exists but is very formal/written."
        }
      ]
