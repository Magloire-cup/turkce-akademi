  "conjTenses": [
    {
      "id": "pres",
      "label": "Present continuous",
      "short": "-yor",
      "usage": "An action in progress at the moment of speaking: « I am …ing »."
    },
    {
      "id": "aor",
      "label": "Present simple",
      "short": "-ir / -er",
      "usage": "A habit, a general truth or a polite offer: « I come (often) »."
    },
    {
      "id": "past",
      "label": "Witnessed past (-di)",
      "short": "-dı / -di",
      "usage": "A completed past action, a fact you have observed: « I came »."
    },
    {
      "id": "evid",
      "label": "Evidential past (-miş)",
      "short": "-mış / -miş",
      "usage": "A past you discovered, heard about or were told: « apparently… », « I saw for myself that… »."
    },
    {
      "id": "fut",
      "label": "Future (-ecek)",
      "short": "-ecek / -acak",
      "usage": "An action to come, an intention or a promise: « I will come »."
    },
    {
      "id": "cond",
      "label": "Conditional (-se)",
      "short": "-se / -sa",
      "usage": "A condition: « if I came… ». The main verb often carries -erdi / -ecekti."
    },
    {
      "id": "imp",
      "label": "Imperative",
      "short": "—",
      "usage": "An order, a piece of advice or an invitation. The imperative has no first person."
    }
  ],
