    {
      "q": "How is « ğ » pronounced?",
      "opts": [
        "like a hard g",
        "it lengthens the preceding vowel",
        "like a k",
        "it is silent"
      ],
      "a": 1,
      "exp": "The soft g does not block the airflow: dağ → « daa »."
    },
    {
      "q": "« şehir » is pronounced…",
      "opts": [
        "seh-heer",
        "sheh-heer",
        "tcheh-heer",
        "zeh-heer"
      ],
      "a": 1,
      "exp": "ş = « sh » (the French « ch »). The city: şehir."
    },
    {
