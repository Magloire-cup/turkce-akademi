          "gelmek",
          "to come"
        ],
        [
          "uzak",
          "far"
        ]
      ],
      "quiz": [
        {
          "q": "How do you say « from school to home »?",
          "options": [
            "okulda eve kadar",
            "okuldan eve kadar",
            "okula evden kadar"
          ],
          "a": 1,
          "why": "The starting point takes the ablative -dan: okuldan; the destination takes the dative: eve."
        },
        {
          "q": "What does « sabah dokuzdan akşam beşe kadar » mean?",
          "options": [
            "From 9 a.m. to 5 p.m.",
