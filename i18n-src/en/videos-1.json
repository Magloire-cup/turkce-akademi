    {
      "id": "va1-1",
      "level": "A1",
      "num": 1,
      "title": "Reading Turkish: alphabet and sounds",
      "tr": "Türk alfabesi ve sesler",
      "goal": "Recognise the 29 letters and pronounce the vowels and consonants that do not exist in French.",
      "watch": "Türk alfabesi",
      "blocks": [
        {
          "t": "p",
          "text": "Turkish is written with a Latin alphabet of <b>29 letters</b>. It does not use <b>q, w, x</b>, but adds <b>ç, ğ, ı, ö, ş, ü</b>. Every letter is always pronounced the same way: once you have learned the sound, you can read any word."
        },
        {
          "t": "table",
          "caption": "The sounds to learn first",
          "head": [
            "Letter",
            "Closest sound",
            "Example"
          ],
          "rows": [
            [
              "<b>a</b>",
              "[a]",
              "<tur>araba</tur> (car)"
            ],
            [
              "<b>e</b>",
              "[ɛ], open",
              "<tur>ev</tur> (house)"
            ],
            [
              "<b>ı</b>",
              "between [e] and [ɨ]",
              "<tur>kır</tur> (countryside)"
            ],
            [
              "<b>i</b>",
              "[i]",
              "<tur>iki</tur> (two)"
            ],
            [
              "<b>o</b>",
              "[o]",
              "<tur>okul</tur> (school)"
            ],
            [
              "<b>ö</b>",
              "[œ] as in French « peur »",
              "<tur>göz</tur> (eye)"
            ],
            [
              "<b>u</b>",
              "[u]",
              "<tur>su</tur> (water)"
            ],
            [
              "<b>ü</b>",
              "[y] as in French « tu »",
              "<tur>gül</tur> (rose)"
            ],
            [
              "<b>c</b>",
              "[dʒ] as in « djinn »",
              "<tur>cam</tur> (glass)"
            ],
            [
              "<b>ç</b>",
              "[tʃ] as in French « chat »",
              "<tur>çay</tur> (tea)"
            ],
            [
              "<b>ş</b>",
              "[ʃ] as in French « chou »",
              "<tur>şehir</tur> (city)"
            ],
            [
              "<b>ğ</b>",
              "lengthens the vowel",
              "<tur>dağ</tur> (mountain)"
            ]
          ]
        },
        {
          "t": "note",
          "kind": "tip",
          "tag": "The ğ",
          "text": "<b>ğ</b> never begins a word and is not pronounced like a g. It lengthens the vowel before it: <tur>dağ</tur> is pronounced [daː], <tur>öğretmen</tur> [øːretmen]. Between two vowels it is barely heard."
        },
        {
          "t": "ex",
          "items": [
            {
              "tr": "Merhaba, Türkçe öğreniyorum.",
              "fr": "Hello, I am learning Turkish."
            },
            {
              "tr": "Şimdi çay içiyorum.",
              "fr": "I am drinking tea right now."
            },
            {
              "tr": "Bu şehir çok güzel.",
              "fr": "This city is very beautiful."
            },
            {
              "tr": "Güle güle, yarın görüşürüz.",
              "fr": "Goodbye, see you tomorrow."
            }
          ]
        },
        {
          "t": "note",
          "kind": "info",
          "tag": "ı or i?",
          "text": "<b>ı</b> is a back vowel, with unrounded lips, close to the schwa. Compare <tur>kır</tur> (countryside) and <tur>kir</tur> (dirt): the difference changes the meaning of the word."
        }
      ],
      "vocab": [
        [
          "merhaba",
          "hello"
        ],
        [
          "günaydın",
          "good morning"
        ],
        [
          "hoşça kal",
          "goodbye (said by the person leaving)"
        ],
        [
          "güle güle",
          "goodbye (said to the person leaving)"
        ],
        [
          "evet",
          "yes"
        ],
        [
          "hayır",
          "no"
        ],
        [
          "lütfen",
          "please"
        ],
        [
          "teşekkürler",
          "thank you"
        ],
        [
          "Türkçe",
          "Turkish"
        ],
        [
          "öğrenmek",
          "to learn"
        ]
      ],
      "quiz": [
        {
          "q": "Which letter is pronounced like the « ch » in « chat »?",
          "options": [
            "ç",
            "ş",
            "c"
          ],
          "a": 0,
          "why": "ç = [tʃ]. The letter ş is pronounced [ʃ], as in « chou »."
        },
        {
          "q": "What does the letter ğ do?",
          "options": [
            "It is pronounced « g »",
            "It lengthens the preceding vowel",
            "It is pronounced « y »"
          ],
          "a": 1,
          "why": "ğ has no sound of its own: dağ is pronounced [daː], with a lengthened a."
        }
      ]
    },
    {
      "id": "va1-2",
      "level": "A1",
      "num": 2,
      "title": "Greeting and introducing yourself",
      "tr": "Selamlaşma ve kendini tanıtma",
      "goal": "Say hello, give your name, your nationality and your job, then switch to the formal you.",
      "watch": "selamlaşma kendini tanıtma",
      "blocks": [
        {
          "t": "table",
          "caption": "Everyday greetings",
          "head": [
            "Turkish",
            "English",
            "When to use it"
          ],
          "rows": [
            [
              "<tur>Merhaba</tur>",
              "hello",
              "all day, with friends or at school"
            ],
            [
              "<tur>Günaydın</tur>",
              "good morning",
              "in the morning, until about noon"
            ],
            [
              "<tur>İyi günler</tur>",
              "have a good day",
              "when leaving, or to greet someone in the afternoon"
            ],
            [
              "<tur>İyi akşamlar</tur>",
              "good evening",
              "at the end of the day"
            ],
            [
              "<tur>İyi geceler</tur>",
              "good night",
              "before going to bed"
            ],
            [
              "<tur>Hoş geldin / Hoş geldiniz</tur>",
              "welcome",
              "to the person who is arriving"
            ],
            [
              "<tur>Hoş bulduk</tur>",
              "thank you, I am glad to be here",
              "reply to « hoş geldin »"
            ],
            [
              "<tur>Görüşürüz</tur>",
              "see you soon",
              "with friends, when leaving"
            ]
          ]
        },
        {
          "t": "p",
          "text": "To introduce yourself, use <tur>Benim adım …</tur> (« my name is… ») or simply <tur>Ben …</tur>. The question is <tur>Adın ne?</tur> with the informal you and <tur>Adınız ne?</tur> with the formal you."
        },
        {
          "t": "table",
          "caption": "The « to be » suffix with öğrenci (student)",
          "head": [
            "Person",
            "Form",
            "Meaning"
          ],
          "rows": [
            [
              "ben",
              "<tur>öğrenciyim</tur>",
              "I am a student"
            ],
            [
              "sen",
              "<tur>öğrencisin</tur>",
              "you are a student"
            ],
            [
              "o",
              "<tur>öğrenci</tur>",
              "he / she is a student"
            ],
            [
              "biz",
              "<tur>öğrenciyiz</tur>",
              "we are students"
            ],
            [
              "siz",
              "<tur>öğrencisiniz</tur>",
              "you are students (plural / formal)"
            ],
            [
              "onlar",
              "<tur>öğrenciler</tur>",
              "they are students"
            ]
          ]
        },
        {
          "t": "ex",
          "items": [
            {
              "tr": "Merhaba, benim adım Ayşe. Memnun oldum.",
              "fr": "Hello, my name is Ayşe. Nice to meet you."
            },
            {
              "tr": "Nerelisiniz? — Ben Fransızım.",
              "fr": "Where are you from? — I am French."
            },
            {
              "tr": "Ne iş yapıyorsunuz? — Öğrenciyim.",
              "fr": "What do you do? — I am a student."
            },
            {
              "tr": "Ben de memnun oldum. Görüşürüz!",
              "fr": "Nice to meet you too. See you soon!"
            }
          ]
        },
        {
          "t": "note",
          "kind": "tip",
          "tag": "sen or siz?",
          "text": "Use <b>sen</b> with friends, family and children. Use <b>siz</b> with a stranger, an elder, a teacher or in a professional setting. The formal you agrees with plural suffixes: <tur>Nasılsınız?</tur> (how are you?)."
        }
      ],
      "vocab": [
        [
          "ad",
          "name"
        ],
        [
          "soyad",
          "surname"
        ],
        [
          "memnun olmak",
          "to be pleased"
        ],
        [
          "tanışmak",
          "to get to know each other"
        ],
