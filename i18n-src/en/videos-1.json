      "quiz": [
        {
          "q": "What is the plural of « kitap »?",
          "options": [
            "kitapler",
            "kitaplar",
            "kitap"
          ],
          "a": 1,
          "why": "The last vowel of kitap is a: the plural is -lar, so kitaplar."
        },
        {
          "q": "What does « şu çanta » mean?",
          "options": [
            "this bag (near)",
            "that bag (a little further away)",
            "these bags"
          ],
          "a": 1,
          "why": "şu refers to a slightly distant object; bu is the nearby object."
        }
      ]
