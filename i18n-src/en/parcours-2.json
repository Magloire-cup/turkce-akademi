      ],
      "quiz": [
        {
          "q": "How do you say «the book I bought»?",
          "options": [
            "aldığım kitap",
            "alan kitap",
            "alacağım kitap"
          ],
          "a": 0,
          "why": "The participle -dik with the first-person possessive gives aldığım."
        },
        {
          "q": "What does «çalışan adam» mean?",
          "options": [
            "the man who works",
            "the man who worked",
            "the man who will work"
          ],
          "a": 0,
          "why": "-en/-an is the present participle: çalışan = who works."
        }
      ]
    },
    {
      "id": "u12",
      "num": 12,
      "level": "B1",
      "title": "The reported past",
      "goal": "Use -miş, pass on information you have not verified, and locate things with postpositions.",
      "blocks": [
        {
          "t": "p",
          "text": "The suffix <b>-miş / -mış / -muş / -müş</b> marks an <b>indirect</b> past: reported information, a discovery, a tale or an event you did not witness. In English, it is rendered with «it seems», «apparently» or «it turns out that»."
        },
        {
          "t": "table",
          "caption": "gelmek in the reported past",
          "head": [
            "Person",
            "Form",
            "Meaning"
          ],
          "rows": [
            [
              "ben",
              "<tur>gelmişim</tur>",
              "apparently I came"
            ],
            [
              "sen",
              "<tur>gelmişsin</tur>",
              "apparently you came"
            ],
            [
              "o",
              "<tur>gelmiş</tur>",
              "he / she apparently came"
            ],
            [
              "biz",
              "<tur>gelmişiz</tur>",
              "apparently we came"
            ],
            [
              "siz",
              "<tur>gelmişsiniz</tur>",
              "apparently you came"
            ],
            [
              "onlar",
              "<tur>gelmişler</tur>",
              "apparently they came"
            ]
          ]
        },
        {
          "t": "note",
          "kind": "info",
          "tag": "Negation and questions",
          "text": "Negative: <tur>gelmemişim</tur> (apparently I did not come). Question: <tur>gelmiş mi?</tur> (So, did he come?)."
        },
        {
          "t": "p",
          "text": "<b>Place postpositions</b> are built with the genitive: <tur>masanın üstünde</tur> (on the table), <tur>kapının yanında</tur> (next to the door), <tur>evin önünde</tur> (in front of the house), <tur>arabanın arkasında</tur> (behind the car)."
        },
        {
          "t": "ex",
          "items": [
            {
              "tr": "Ali eve gelmiş.",
              "fr": "Apparently, Ali went home."
            },
            {
              "tr": "Ayşe yeni bir iş bulmuş.",
              "fr": "I hear that Ayşe has found a new job."
            },
            {
              "tr": "Kitabım masanın üstünde.",
              "fr": "My book is on the table."
            },
            {
              "tr": "Duyduğuma göre hava yarın düzelecek.",
              "fr": "From what I have heard, the weather will improve tomorrow."
            }
          ]
        },
        {
          "t": "note",
          "kind": "tip",
          "tag": "Don't confuse",
          "text": "<tur>Geldi</tur> = I saw it happen, I witnessed it. <tur>Gelmiş</tur> = someone told me, I am inferring it. The choice of suffix changes the source of the information."
        }
      ],
      "vocab": [
