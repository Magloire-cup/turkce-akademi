    {
      "id": "u8",
      "num": 8,
      "level": "A2",
      "title": "Talking about the future",
      "goal": "Use the future -ecek, talk about the weather and make plans.",
      "blocks": [
        {
          "t": "p",
          "text": "The future is formed with <b>-ecek / -acak</b>, according to vowel harmony. In the first person, the k becomes ğ: <tur>geleceğim</tur>."
        },
        {
          "t": "table",
          "caption": "gelmek (to come) in the future",
          "head": [
            "Person",
            "Form",
            "Meaning"
          ],
          "rows": [
            [
              "ben",
              "<tur>geleceğim</tur>",
              "I will come"
            ],
            [
              "sen",
              "<tur>geleceksin</tur>",
              "you will come"
            ],
            [
              "o",
              "<tur>gelecek</tur>",
              "he / she will come"
            ],
            [
              "biz",
              "<tur>geleceğiz</tur>",
              "we will come"
            ],
            [
              "siz",
              "<tur>geleceksiniz</tur>",
              "you will come"
            ],
            [
              "onlar",
              "<tur>gelecekler</tur>",
              "they will come"
            ]
          ]
        },
        {
          "t": "note",
          "kind": "info",
          "tag": "Negation and questions",
          "text": "Negative: <tur>gelmeyeceğim</tur> (I will not come). Question: <tur>gelecek misin?</tur> (Will you come?)."
        },
        {
          "t": "table",
          "caption": "Weather and compass points",
          "head": [
            "Turkish",
            "English"
          ],
          "rows": [
            [
              "<tur>güneşli</tur>",
              "sunny"
            ],
            [
              "<tur>bulutlu</tur>",
              "cloudy"
            ],
            [
              "<tur>yağmurlu</tur>",
              "rainy"
            ],
            [
              "<tur>rüzgarlı</tur>",
              "windy"
            ],
            [
              "<tur>kuzey / güney</tur>",
              "north / south"
            ],
            [
              "<tur>doğu / batı</tur>",
              "east / west"
            ]
          ]
        },
        {
          "t": "ex",
          "items": [
            {
              "tr": "Yarın İstanbul'a gideceğim.",
              "fr": "Tomorrow I will go to Istanbul."
            },
            {
              "tr": "Hava yarın yağmurlu olacak.",
              "fr": "It will rain tomorrow."
            },
            {
              "tr": "Gelecek yaz Türkçe öğreneceğim.",
              "fr": "Next summer I will learn Turkish."
            },
            {
              "tr": "Ne zaman döneceksin?",
              "fr": "When will you come back?"
            }
          ]
        },
        {
          "t": "note",
          "kind": "tip",
          "tag": "Future time markers",
          "text": "<tur>yarın</tur> (tomorrow), <tur>gelecek hafta</tur> (next week), <tur>bir saat sonra</tur> (in an hour), <tur>yakında</tur> (soon)."
        }
      ],
