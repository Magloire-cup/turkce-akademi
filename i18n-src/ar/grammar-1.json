{
  "domain": "grammar",
  "fields": "title, blocks",
  "start": 0,
  "end": 8,
  "items": [
    {
      "id": "alphabet",
      "title": "الأبجدية التركية والنطق",
      "level": "A1",
      "blocks": [
        {
          "t": "p",
          "text": "تضم التركية 29 حرفا، كلها قابلة للنطق، ولا استثناء: فهي تكتب كما تنطق. تعود الأبجدية اللاتينية إلى عام 1928 (إصلاح أتاتورك). أما الحروف q وw وx فغير موجودة."
        },
        {
          "t": "table",
          "caption": "الحروف «الجديدة»",
          "head": [
            "الحرف",
            "الصوت",
            "المثال"
          ],
          "rows": [
            [
              "ç",
              "«تش»",
              "<tur>çay</tur> (شاي)"
            ],
            [
              "ş",
              "«ش»",
              "<tur>şehir</tur> (مدينة)"
            ],
            [
              "c",
              "«ج»",
              "<tur>cam</tur> (زجاج)"
            ],
            [
              "j",
              "«ژ» (نادر)",
              "<tur>jilet</tur> (شفرة حلاقة)"
            ],
            [
              "ğ",
              "يطيل حرف العلة السابق",
              "<tur>dağ</tur> (جبل) → «داا»"
            ],
            [
              "ı",
              "صوت قصير غير مدور قريب من الكسرة",
              "<tur>ışık</tur> (ضوء)"
            ],
            [
              "ö",
              "صوت بين الفتحة والضمة مع تدوير الشفتين",
              "<tur>göz</tur> (عين)"
            ],
            [
              "ü",
              "صوت بين الكسرة والضمة مع تدوير الشفتين",
              "<tur>gül</tur> (وردة)"
            ]
          ]
        },
        {
          "t": "ul",
          "items": [
            "حرف <b>h</b> ينطق دائما بدفعة هواء واضحة: <tur>hava</tur> (هواء).",
            "حرف <b>r</b> يلفظ بترعيد خفيف.",
            "يقع النبر على <b>المقطع الأخير</b> (إلا في استثناءات: أسماء الأماكن المنتهية بـ -e).",
            "الحرف الكبير من ı هو I، والحرف الكبير من i هو İ. فخ شائع!"
          ]
        }
      ]
    },
    {
      "id": "harmonie",
      "title": "التناغم الصوتي",
      "level": "A1",
      "blocks": [
        {
          "t": "p",
          "text": "القاعدة الأساسية في التركية: اللواحق تحاكي حروف العلة في الكلمة. وهناك تناغمان."
        },
        {
          "t": "table",
          "caption": "عائلات حروف العلة",
          "head": [
            "خلفية (مظلمة)",
            "أمامية (فاتحة)"
          ],
          "rows": [
            [
              "a, ı, o, u",
              "e, i, ö, ü"
            ]
          ]
        },
        {
          "t": "h",
          "text": "التناغم الثنائي (a/e)"
        },
        {
          "t": "table",
          "caption": "أمثلة مع جمع -ler/-lar",
          "head": [
            "الكلمة",
            "العائلة",
            "الجمع"
          ],
          "rows": [
            [
              "<tur>ev</tur>",
              "أمامية (e)",
              "<tur>evler</tur>"
            ],
            [
              "<tur>masa</tur>",
              "خلفية (a)",
              "<tur>masalar</tur>"
            ],
            [
              "<tur>göz</tur>",
              "أمامية (ö)",
              "<tur>gözler</tur>"
            ]
          ]
        },
        {
          "t": "h",
          "text": "التناغم الرباعي (i/ı/ü/u)"
        },
        {
          "t": "table",
          "caption": "أمثلة مع حالة النصب -i",
          "head": [
            "حرف العلة الأخير",
            "اللاحقة",
            "المثال"
          ],
          "rows": [
            [
              "e, i",
              "-i",
              "<tur>evi</tur> (البيت)"
            ],
            [
              "a, ı",
              "-ı",
              "<tur>masayı</tur> (الطاولة: مع y)"
            ],
            [
              "ö, ü",
              "-ü",
              "<tur>gözü</tur> (العين)"
            ],
            [
              "o, u",
              "-u",
              "<tur>okulu</tur> (المدرسة)"
            ]
          ]
        },
        {
          "t": "note",
          "kind": "tip",
          "tag": "الطريقة",
          "text": "انظر فقط إلى <b>حرف العلة الأخير</b> في الكلمة، وحدد عائلته، ثم طبق اللاحقة. ومع قليل من التمرين، ستقرر أذنك وحدها."
        }
      ]
    },
    {
      "id": "agglutination",
      "title": "الإلصاق: كلمات مثل مكعبات ليغو",
      "level": "A1",
      "blocks": [
        {
          "t": "p",
          "text": "تعبر التركية بـ<b>اللواحق</b> عما تعبر عنه العربية بأدوات منفصلة. وترتيب التركيب صارم: الجمع ثم الملكية ثم الحالة."
        },
        {
          "t": "table",
          "caption": "تفكيك كلمة كاملة",
          "head": [
            "المرحلة",
            "الكلمة",
            "المعنى"
          ],
          "rows": [
            [
              "الجذر",
              "<tur>ev</tur>",
              "بيت"
            ],
            [
              "+ الجمع",
              "<tur>evler</tur>",
              "البيوت"
            ],
            [
              "+ الملكية",
              "<tur>evlerim</tur>",
              "بيوتي"
            ],
            [
              "+ حالة المكان",
              "<tur>evlerimde</tur>",
              "في بيوتي"
            ]
          ]
        },
        {
          "t": "p",
          "text": "المنطق يسير من <b>الأعم إلى الأخص</b>: الشيء، ثم الكمية (<tur>-ler/-lar</tur>)، ثم المالك (<tur>-im</tur>…)، ثم الوظيفة في الجملة (<tur>-de</tur>، <tur>-den</tur>…)."
        },
        {
          "t": "table",
          "caption": "الجذر نفسه بثلاث درجات من التحديد",
          "head": [
            "الصيغة",
            "الكلمة",
            "المعنى"
          ],
          "rows": [
            [
              "جذر + جمع + حالة المكان",
              "<tur>evlerde</tur>",
              "في البيوت"
            ],
            [
              "جذر + ملكية + حالة المكان",
              "<tur>evimde</tur>",
              "في بيتي"
            ],
            [
              "جذر + جمع + ملكية + حالة المكان",
              "<tur>evlerimde</tur>",
              "في بيوتي"
            ]
          ]
        },
        {
          "t": "note",
          "kind": "info",
          "tag": "اسمان مرتبطان",
          "text": "تربط <b>حالة الإضافة</b> اسمين: فهي توضع على <b>المالك</b>، بينما توضع <b>لاحقة الملكية</b> على الشيء المملوك. مثال: <tur>evin kapısı</tur> (باب البيت) = <tur>ev-in</tur> + <tur>kapı-sı</tur>. حالة الإضافة تغلق الكلمة الأولى؛ ولا تتسلل بعد لاحقة الملكية في الكلمة الثانية."
        },
        {
          "t": "p",
          "text": "المبدأ نفسه في الأفعال: جذر + نفي + زمن + شخص. <tur>gel-me-di-m</tur> = لم آت. كلمة واحدة = جملة صغيرة."
        },
        {
          "t": "note",
          "kind": "tip",
          "tag": "القراءة",
          "text": "أمام كلمة تركية طويلة، فككها من اليمين: -ler/-lar؟ ملكية؟ حالة؟ ثم تناول الجذر المتبقي."
        }
      ]
    },
    {
      "id": "etre",
      "title": "الكينونة (بلا فعل) وdeğil",
      "level": "A1",
      "blocks": [
        {
          "t": "p",
          "text": "لا يوجد فعل «يكون» في المضارع: بل تضاف لواحق إلى الاسم. ويعتمد النفي على <tur>değil</tur>، وهي كلمة توضع بعد الاسم وتأخذ هي نفسها لواحق الأشخاص."
        },
        {
          "t": "table",
          "caption": "المثبت / المنفي",
          "head": [
            "الشخص",
            "المثبت",
            "المنفي"
          ],
          "rows": [
            [
              "ben",
              "<tur>öğretmenim</tur>",
              "<tur>öğretmen değilim</tur>"
            ],
            [
              "sen",
              "<tur>öğrencisin</tur>",
              "<tur>öğrenci değilsin</tur>"
            ],
            [
              "o",
              "<tur>doktor</tur>",
              "<tur>doktor değil</tur>"
            ],
            [
              "biz",
              "<tur>Türküz</tur>",
              "<tur>Türk değiliz</tur>"
            ],
            [
              "siz",
              "<tur>yorgunsunuz</tur>",
              "<tur>yorgun değilsiniz</tur>"
            ],
            [
              "onlar",
              "<tur>öğretmen</tur>",
              "<tur>öğretmen değiller</tur>"
            ]
          ]
        },
        {
          "t": "p",
          "text": "توجد اللاحقة -dir للشخص الثالث (رسمية جدا، في الكتابة والإعلانات): <tur>Güzeldir.</tur> (إنه جميل، على وجه اليقين)."
        }
      ]
    },
    {
      "id": "pluriel",
      "title": "الجمع -ler / -lar",
      "level": "A1",
      "blocks": [
        {
          "t": "p",
          "text": "قطعة بسيطة: -ler بعد حرف علة أمامي، و-lar بعد حرف علة خلفي."
        },
        {
          "t": "ex",
          "items": [
            {
              "tr": "kitap → kitaplar",
              "fr": "كتاب → كتب"
            },
            {
              "tr": "şehir → şehirler",
              "fr": "مدينة → مدن"
            },
            {
              "tr": "kadın → kadınlar",
              "fr": "امرأة → نساء"
            },
            {
              "tr": "gül → güller",
              "fr": "وردة → ورود"
            }
          ]
        },
        {
          "t": "note",
          "kind": "warn",
          "tag": "قاعدة",
          "text": "بعد <b>عدد</b> أو كلمة كمية (çok, biraz)، يبقى الاسم مفردا: <tur>üç kitap</tur> (ثلاثة كتب)، <tur>çok para</tur> (مال كثير)."
        },
        {
          "t": "p",
          "text": "مع لواحق الأشخاص في الفعل، يمكن أن يتضاعف جمع الغائبين: <tur>geldiler</tur> أو <tur>gelmışlerdir</tur>… عمليا: تضاف -ler إلى صيغة جمع الشخص الثالث المحددة سلفا (onlar geldiler)."
        }
      ]
    },
    {
      "id": "pronoms",
      "title": "الضمائر وأسماء الإشارة",
      "level": "A1",
      "blocks": [
        {
          "t": "table",
          "caption": "الضمائر الشخصية",
          "head": [
            "التركية",
            "العربية"
          ],
          "rows": [
            [
              "<tur>ben, sen, o</tur>",
              "أنا، أنت، هو/هي"
            ],
            [
              "<tur>biz, siz, onlar</tur>",
              "نحن، أنتم، هم/هن"
            ]
          ]
        },
        {
          "t": "table",
          "caption": "أسماء الإشارة والاستفهام",
          "head": [
            "التركية",
            "العربية"
          ],
          "rows": [
            [
              "<tur>bu</tur>",
              "هذا (قريب)"
            ],
            [
              "<tur>şu</tur>",
              "ذلك (أبعد قليلا)"
            ],
            [
              "<tur>o</tur>",
              "ذاك (بعيد) = أيضا «هو/هي»"
            ],
            [
              "<tur>ne, kim, nerede</tur>",
              "ماذا، من، أين"
            ]
          ]
        },
        {
          "t": "p",
          "text": "غالبا ما تكون الضمائر <b>ضمنية</b>: فنهاية الفعل تدل أصلا على الشخص. <tur>Geliyorum</tur> تكفي لـ«أنا قادم»."
        },
        {
          "t": "p",
          "text": "ضمير المخاطب الرسمي (siz) لازم مع الغرباء وكبار السن وفي المتاجر: لكن الأتراك ينتقلون سريعا إلى المخاطبة غير الرسمية الودودة، خصوصا بين الشباب."
        }
      ]
    },
    {
      "id": "cas",
      "title": "الحالات الإعرابية الست",
      "level": "A2",
      "blocks": [
        {
          "t": "p",
          "text": "«حروف الجر» التركية هي لواحق. ست حالات، ولكل منها وظيفتها. ويدخل حرف الوصل y بعد حرف العلة الأخير؛ أما الحروف الساكنة المهموسة في النهاية (p ç t k s ş f h) فيلفظ d بعدها t."
        },
        {
          "t": "table",
          "caption": "نظرة شاملة على الحالات الست (مثال: ev، «بيت»)",
          "head": [
            "الحالة",
            "اللاحقة",
            "المثال",
            "الوظيفة"
          ],
          "rows": [
            [
              "الرفع",
              "Ø",
              "<tur>ev</tur>",
              "الفاعل / مفعول به غير محدد"
            ],
            [
              "النصب",
              "-i/-ı/-u/-ü",
              "<tur>evi</tur>",
              "مفعول به محدد"
            ],
            [
              "التوجيه",
              "-e/-a",
              "<tur>eve</tur>",
              "إلى، نحو (الوجهة)"
            ],
            [
              "المكان",
              "-de/-da",
              "<tur>evde</tur>",
              "في، عند، على (المكان)"
            ],
            [
              "الابتداء",
              "-den/-dan",
              "<tur>evden</tur>",
              "من، منذ (المنشأ)"
            ],
            [
              "الإضافة",
              "-in/-ın/-un/-ün",
              "<tur>evin</tur>",
              "التملك (الملكية)"
            ]
          ]
        },
        {
          "t": "table",
          "caption": "أمثلة حية",
          "head": [
            "التركية",
            "العربية"
          ],
          "rows": [
            [
              "<tur>Kitabı okudum.</tur>",
              "قرأت الكتاب. (النصب)"
            ],
            [
              "<tur>Okula gidiyorum.</tur>",
              "أذهب إلى المدرسة. (التوجيه)"
            ],
            [
              "<tur>Okuldayım.</tur>",
              "أنا في المدرسة. (المكان)"
            ],
            [
              "<tur>Okuldan geliyorum.</tur>",
              "أجيء من المدرسة. (الابتداء)"
            ],
            [
              "<tur>Öğretmenin adı Ali.</tur>",
              "اسم المعلم Ali. (الإضافة)"
            ]
          ]
        },
        {
          "t": "note",
          "kind": "tip",
          "tag": "الحروف الساكنة المهموسة",
          "text": "p ç t k s ş f h → يتحول d إلى t: <tur>sokakta</tur> (في الشارع)، <tur>işte</tur> (في العمل)، <tur>otobüste</tur> (في الحافلة)."
        }
      ]
    },
    {
      "id": "possessif",
      "title": "الملكية",
      "level": "A2",
      "blocks": [
        {
          "t": "p",
          "text": "يحمل الشيء المملوك لاحقة ملكية؛ ويحمل المالك (إن ظهر) حالة الإضافة. البنية: المالك مع حالة الإضافة + المملوك مع لاحقة الملكية."
        },
        {
          "t": "table",
          "caption": "لواحق الملكية (مع «anne»، أم)",
          "head": [
            "الشخص",
            "اللاحقة",
            "المثال",
            "المعنى"
          ],
          "rows": [
            [
              "لي",
              "-im",
              "<tur>annem</tur>",
              "أمي"
            ],
            [
              "لك",
              "-in",
              "<tur>annen</tur>",
              "أمك"
            ],
            [
              "له/لها",
              "-i",
              "<tur>annesi</tur>",
              "أمه/أمها"
            ],
            [
              "لنا",
              "-imiz",
              "<tur>annemiz</tur>",
              "أمنا"
            ],
            [
              "لكم",
              "-iniz",
              "<tur>anneniz</tur>",
              "أمكم"
            ],
            [
              "لهم",
              "-leri",
              "<tur>anneleri</tur>",
              "أمهم"
            ]
          ]
        },
        {
          "t": "ex",
          "items": [
            {
              "tr": "Ali'nin arabası",
              "fr": "سيارة Ali"
            },
            {
              "tr": "benim evim",
              "fr": "بيتي"
            },
            {
              "tr": "öğretmenin kitapları",
              "fr": "كتب المعلم"
            }
          ]
        },
        {
          "t": "note",
          "kind": "warn",
          "tag": "حروف الوصل",
          "text": "بعد حرف علة أخير: يأخذ الشخص الثالث حرف الوصل <b>n</b> (<tur>araba<b>sı</b></tur> = سيارته، <tur>oda<b>sı</b></tur> = غرفته)؛ أما بقية الأشخاص فتتصل مباشرة (<tur>araba<b>m</b></tur> = سيارتي، <tur>oda<b>n</b></tur> = غرفتك). وأما حرف الوصل <b>y</b> فيستخدم في الكينونة والحالات: <tur>odayım</tur> (أنا في الغرفة)، <tur>odaya</tur> (نحو الغرفة)."
        }
      ]
    }
  ]
}
