  "items": [
    {
      "id": "m1",
      "num": 1,
      "level": "A1",
      "title": "الأبجدية التركية والكلمات الأولى",
      "subtitle": "نطق الحروف التسعة والعشرين والتحية كما يفعل أهل البلد",
      "objectifs": [
        "معرفة الحروف التسعة والعشرين في الأبجدية التركية",
        "إتقان نطق ç وş وğ وı وö وü",
        "قراءة أي كلمة تركية بصوت عال",
        "التحية والشكر"
      ],
      "blocks": [
        {
          "t": "p",
          "text": "خبر سار: التركية لغة <b>صوتية</b>. لكل حرف نطق ثابت واحد، دون استثناء. وبمجرد إتقان الأبجدية، تستطيع قراءة أي كلمة، حتى من دون فهمها. يعتمد الأتراك الأبجدية اللاتينية منذ عام 1928، بعد إصلاح الحروف الكبير الذي أراده <b>Atatürk</b>."
        },
        {
          "t": "h",
          "text": "أحرف العلة الثمانية"
        },
        {
          "t": "p",
          "text": "في التركية ثمانية أحرف علة. أربعة منها مألوفة لديك (a وe وi كما في الإسبانية، وo)، وأربعة تحتاج إلى جهد صغير."
        },
        {
          "t": "table",
          "caption": "أحرف العلة التركية",
          "head": [
            "الحرف",
            "النطق (تقريب عربي)",
            "مثال"
          ],
          "rows": [
            [
              "a / e / i / o",
              "a، e، i (قصير وواضح)، o",
              "<tur>elma</tur> (تفاحة)"
            ],
            [
              "u",
              "صوت الضمة، قصير",
              "<tur>okul</tur> (مدرسة)"
            ],
            [
              "ı (i دون نقطة)",
              "صوت قصير غير مدور، بين الفتحة والكسرة",
              "<tur>ışık</tur> (ضوء)"
            ],
            [
              "ü",
              "صوت بين الضمة والكسرة مع تدوير الشفتين",
              "<tur>gül</tur> (وردة)"
            ],
            [
              "ö",
              "صوت بين الفتحة والضمة مع تدوير الشفتين",
              "<tur>göz</tur> (عين)"
            ]
          ]
        },
        {
          "t": "note",
          "kind": "tip",
          "tag": "نصيحة",
          "text": "احترس من الفخ الشائع: <b>ı</b> (I كبيرة بلا نقطة) و<b>i</b> (İ بنقطة) حرفان مختلفان. <tur>kedi</tur> (قطة) ≠ <tur>kırmızı</tur> (أحمر)."
        },
        {
          "t": "h",
          "text": "الحروف الساكنة التي تغير كل شيء"
        },
        {
          "t": "table",
          "caption": "حروف ساكنة خاصة",
          "head": [
            "الحرف",
            "النطق",
            "مثال"
          ],
          "rows": [
            [
              "ç",
              "«تش»",
              "<tur>çay</tur> (شاي): تشاي"
            ],
            [
              "ş",
              "«ش»",
              "<tur>şehir</tur> (مدينة): شهير"
            ],
            [
              "c",
              "«ج»",
              "<tur>cam</tur> (زجاج): جام"
            ],
            [
              "j",
              "«ژ» (نادر)",
              "<tur>jilet</tur> (شفرة حلاقة)"
            ],
            [
              "ğ",
              "يكاد لا ينطق: يطيل حرف العلة الذي قبله",
              "<tur>dağ</tur> (جبل): «داا»"
            ],
            [
              "h",
              "يخرج دائما بدفعة هواء، كما في الإنجليزية",
              "<tur>hava</tur> (هواء، طقس)"
            ]
          ]
        },
        {
          "t": "p",
          "text": "يمكن نطق بقية الحروف على نحو قريب من قيمتها في الأبجدية اللاتينية، مع تفصيلين: <b>r</b> مكررة، و<b>v</b> أحيانا ألين، بين صوتي «v» و«w». و<b>y</b> تنطق «ي» كما في «يا»."
        },
        {
          "t": "h",
          "text": "اقرأ بصوت عال"
        },
        {
          "t": "ex",
          "items": [
            {
              "tr": "Merhaba",
              "fr": "مرحبا"
            },
            {
              "tr": "teşekkür ederim",
              "fr": "شكرا"
            },
            {
              "tr": "günaydın",
              "fr": "صباح الخير"
            },
            {
              "tr": "nasılsın?",
              "fr": "كيف حالك؟"
            },
            {
              "tr": "çok güzel",
              "fr": "جميل جدا / حسن جدا"
            },
            {
              "tr": "hoş geldiniz",
              "fr": "أهلا وسهلا"
            }
          ]
        },
        {
          "t": "note",
          "kind": "tip",
          "tag": "الطريقة",
          "text": "استمع إلى كل كلمة عبر زر السماعة، ثم كررها بصوت عال محاكيا الإيقاع. التركية لغة نبرتها في النهاية: يقع النبر في الغالب على <b>المقطع الأخير</b>: merhaba (merha-<b>BA</b>)، güzel (gu-<b>ZEL</b>)، teşekkür (te-şek-<b>KÜR</b>)."
        }
      ],
      "dialogue": {
        "title": "لقاء أول",
        "lines": [
          {
            "name": "Elif",
            "tr": "Merhaba!",
            "fr": "مرحبا!"
          },
          {
            "name": "Magloire",
            "tr": "Merhaba, nasılsın?",
            "fr": "مرحبا، كيف حالك؟"
          },
          {
            "name": "Elif",
            "tr": "İyiyim, teşekkür ederim. Sen nasılsın?",
            "fr": "أنا بخير، شكرا. وأنت؟"
          },
          {
            "name": "Magloire",
            "tr": "Ben de iyiyim. Adın ne?",
            "fr": "أنا كذلك بخير. ما اسمك؟"
          },
          {
            "name": "Elif",
            "tr": "Benim adım Elif. Sen?",
            "fr": "اسمي Elif. وأنت؟"
          },
          {
            "name": "Magloire",
            "tr": "Ben Magloire. Memnun oldum!",
            "fr": "أنا Magloire. تشرفت بلقائك!"
          },
          {
            "name": "Elif",
            "tr": "Ben de memnun oldum. Görüşürüz!",
            "fr": "تشرفت بلقائك كذلك. إلى اللقاء قريبا!"
          }
        ]
      },
