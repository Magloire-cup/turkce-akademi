      "quiz": [
        {
          "q": "كيف ينطق الحرف «ş»؟",
          "opts": [
            "«ش» كما في «شمس»",
            "«تش» كما في «تشاد»",
            "«س» صفيرية",
            "«ج» الفرنسية"
          ],
          "a": 0,
          "exp": "نطق ş مثل «ش» في العربية: şehir = شهير."
        },
        {
          "q": "كم عدد حروف الأبجدية التركية؟",
          "opts": [
            "26",
            "29",
            "32",
            "24"
          ],
          "a": 1,
          "exp": "29 حرفا: الأبجدية اللاتينية ناقص q وw وx، وزائد ç وğ وı وö وş وü."
        },
        {
          "q": "الحرف «ğ» (g اللينة)…",
          "opts": [
            "ينطق مثل «g» شديدة",
            "يطيل حرف العلة الذي قبله",
            "لم يبق مستخدما في الكتابة اليوم",
            "ينطق «ي»"
          ],
          "a": 1,
          "exp": "dağ = «داا»: لا يكون ğ صوت g شديدا أبدا، بل يمد حرف العلة."
        },
        {
          "q": "كيف ينطق «ı» (I دون نقطة)؟",
          "opts": [
            "مثل «إي» العربية",
            "صوت قصير غير مدور بين الفتحة والكسرة",
            "مثل «ي»",
            "هو حرف صامت"
          ],
          "a": 1,
          "exp": "Iı صوت قصير غير مدور، وışık (ضوء) = «إشيك»."
        },
        {
          "q": "ماذا تعني «teşekkür ederim»؟",
          "opts": [
            "إلى اللقاء",
            "من فضلك",
            "شكرا",
            "عفوا"
          ],
          "a": 2,
          "exp": "teşekkür ederim = أشكرك. والصيغة القصيرة غير الرسمية: sağ ol."
        }
      ]
    },
    {
      "id": "m2",
      "num": 2,
      "level": "A1",
      "title": "تقديم نفسك: أنا…",
      "subtitle": "فعل الكينونة غير موجود: اللاحقة تلتصق بنهاية الكلمة",
      "objectifs": [
        "قول اسمك وجنسيتك ومهنتك",
        "فهم منطق لواحق الضمائر",
        "السؤال «وأنت؟»"
      ],
      "blocks": [
        {
          "t": "p",
          "text": "مفاجأة: في التركية <b>لا يوجد فعل «يكون» في المضارع</b>. لقول «أنا طالب»، نعلق لاحقة صغيرة بنهاية الاسم: <tur>öğrenci</tur> + <b>-im</b> → <tur>öğrenciyim</tur>. الضمير (ben، sen…) اختياري: فاللاحقة تحدد المتكلم."
        },
        {
          "t": "h",
          "text": "تصريف فعل الكينونة"
        },
        {
          "t": "table",
          "caption": "لواحق الضمائر في الكينونة",
          "head": [
            "الضمير",
            "اللاحقة",
            "مثال",
            "الترجمة"
          ],
          "rows": [
            [
              "ben (أنا)",
              "-im / -ım / -üm / -um",
              "<tur>öğretmenim</tur>",
              "أنا معلم"
            ],
            [
              "sen (أنت)",
              "-sin / -sın / -sün / -sun",
              "<tur>öğrencisin</tur>",
              "أنت طالب"
            ],
            [
              "o (هو/هي)",
              "Ø",
              "<tur>doktor</tur>",
              "هو طبيب"
            ],
            [
              "biz (نحن)",
              "-iz / -ız / -üz / -uz",
              "<tur>Türküz</tur>",
              "نحن أتراك"
            ],
            [
              "siz (أنتم)",
              "-siniz / -sınız / -sünüz / -sunuz",
              "<tur>yorgunsunuz</tur>",
              "أنتم متعبون"
            ],
            [
              "onlar (هم)",
              "Ø (أو -ler)",
              "<tur>öğretmen</tur>",
              "هم معلمون"
            ]
          ]
        },
        {
          "t": "note",
          "kind": "info",
          "tag": "لماذا أربع صيغ؟",
          "text": "-im، -ım، -üm، -um… تتكيف اللاحقة مع حرف العلة الأخير في الكلمة. هذا هو <b>التناغم الصوتي</b>، المقرر في الوحدة 4. الآن، احفظ كل كلمة ككتلة واحدة."
        },
        {
          "t": "h",
          "text": "اسمك الأول"
        },
        {
          "t": "p",
          "text": "طريقتان لقول اسمك: <tur>Benim adım Elif</tur> (اسمي Elif: حرفيا «ad-ım») أو ببساطة <tur>Ben Elif</tur> (أنا [هو] Elif). وللسؤال: <tur>Adın ne?</tur> (أنت) / <tur>Adınız ne?</tur> (أنتم)."
        },
        {
          "t": "h",
          "text": "الجنسيات والمهن"
        },
        {
          "t": "ex",
          "items": [
            {
              "tr": "Ben Magloire. Fransızım.",
              "fr": "اسمي Magloire. أنا فرنسي."
            },
            {
              "tr": "Ben Türküm.",
              "fr": "أنا تركي."
            },
            {
              "tr": "Öğretmenim.",
              "fr": "أنا معلم/معلمة."
            },
            {
              "tr": "Mühendisim.",
              "fr": "أنا مهندس/مهندسة."
            },
            {
              "tr": "Öğrenci misin?",
              "fr": "هل أنت طالب؟"
            },
            {
              "tr": "Evet, öğrenciyim.",
              "fr": "نعم، أنا طالب."
            }
          ]
        },
        {
          "t": "note",
          "kind": "tip",
          "tag": "ثقافة",
          "text": "السؤال <tur>nerelisin?</tur> يعني «من أين أنت؟». إجابات طبيعية: <tur>Fransızım</tur> (أنا فرنسي) أو <tur>Fransa'dan geliyorum</tur> (أنا قادم من فرنسا)."
        }
      ],
      "dialogue": {
        "title": "في كافتيريا الجامعة",
        "lines": [
          {
            "name": "Magloire",
            "tr": "Merhaba! Burada oturabilir miyim?",
            "fr": "مرحبا! هل يمكنني الجلوس هنا؟"
          },
          {
            "name": "Zeynep",
            "tr": "Tabii, buyurun.",
            "fr": "بالطبع، تفضل."
          },
          {
            "name": "Magloire",
            "tr": "Benim adım Magloire. Siz öğrenci misiniz?",
            "fr": "اسمي Magloire. هل أنت طالبة؟"
          },
          {
            "name": "Zeynep",
            "tr": "Hayır, ben öğretmenim. Fransızca dersleri veriyorum.",
            "fr": "لا، أنا معلمة. أقوم بتدريس اللغة الفرنسية."
          },
          {
            "name": "Magloire",
            "tr": "Ah, çok güzel! Ben Fransızım, mühendislik öğrencisiyim.",
            "fr": "آه، رائع جدا! أنا فرنسي، طالب هندسة."
          },
          {
            "name": "Zeynep",
            "tr": "Hoş geldiniz! Türkçe öğreniyorsunuz, çok başarılısınız.",
            "fr": "أهلا وسهلا! أنت تتعلم التركية، وأنت بارع جدا."
          },
          {
            "name": "Magloire",
            "tr": "Teşekkür ederim!",
            "fr": "شكرا!"
          }
        ]
      },
