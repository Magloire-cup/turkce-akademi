  "items": [
    {
      "id": "m5",
      "num": 5,
      "level": "A2",
      "title": "الإلصاق والجمع",
      "subtitle": "بناء الكلمات كما تُبنى مكعبات ليغو",
      "objectifs": [
        "فهم منطق اللواحق المتسلسلة",
        "تكوين الجمع",
        "معرفة ترتيب اللواحق"
      ],
      "blocks": [
        {
          "t": "p",
          "text": "التركية لغة <b>إلصاقية</b>: فبدلًا من كلمات مستقلة (حروف الجر، ضمائر الملكية…)، <b>نُلصق</b> وحدات معنوية في آخر الكلمة. ويمكن أن تكون الكلمة التركية الواحدة جملة كاملة. والمثال الأشهر:"
        },
        {
          "t": "table",
          "caption": "تشريح الكلمة",
          "head": [
            "الوحدة",
            "المعنى",
            "المجموع التراكمي"
          ],
          "rows": [
            [
              "<tur>ev</tur>",
              "بيت",
              "البيت"
            ],
            [
              "<tur>ev-ler</tur>",
              "+ الجمع",
              "البيوت"
            ],
            [
              "<tur>ev-ler-im</tur>",
              "+ ملكية المتكلم",
              "بيوتي"
            ],
            [
              "<tur>ev-ler-im-de</tur>",
              "+ في (حالة المكان)",
              "في بيوتي"
            ]
          ]
        },
        {
          "t": "p",
          "text": "أربع وحدات، دون أي كلمة أداة. وهو المبدأ نفسه الذي نألفه في علامات الجمع، لكنه معمَّم على كل شيء: الملكية والحالة والزمن والشخص."
        },
        {
          "t": "h",
          "text": "الجمع: -ler / -lar"
        },
        {
          "t": "ex",
          "items": [
            {
              "tr": "kitap → kitaplar",
              "fr": "كتاب ← كتب"
            },
            {
              "tr": "şehir → şehirler",
              "fr": "مدينة ← مدن"
            },
            {
              "tr": "çocuk → çocuklar",
              "fr": "طفل ← أطفال"
            },
            {
              "tr": "kadın → kadınlar",
              "fr": "امرأة ← نساء"
            }
          ]
        },
        {
          "t": "note",
          "kind": "warn",
          "tag": "تنبيه",
          "text": "بعد العدد يبقى الاسم في <b>المفرد</b>: <tur>üç elma</tur> (ثلاث تفاحات)، ولا يُقال « üç elmalar » أبدًا. ويمكن توضيح الكمية بكلمة <tur>tane</tur>: <tur>üç tane elma</tur> (ثلاث تفاحات، حرفيًا «ثلاث قطع من التفاح»)."
        },
        {
          "t": "h",
          "text": "ترتيب الوحدات"
        },
        {
          "t": "p",
          "text": "تأتي اللواحق دائمًا بالترتيب نفسه، كوصفة: <b>1.</b> الجمع ← <b>2.</b> الملكية ← <b>3.</b> الحالة. وهكذا <tur>evlerimde</tur> = ev-ler-im-de. ولا يمكن عكس الترتيب."
        },
        {
          "t": "ex",
          "items": [
            {
              "tr": "evlerde",
              "fr": "في البيوت (جمع + حالة المكان)"
            },
            {
              "tr": "evimde",
              "fr": "في بيتي (ملكية + حالة المكان)"
            },
            {
              "tr": "evlerimde",
              "fr": "في بيوتي (جمع + ملكية + حالة المكان)"
            }
          ]
        },
        {
          "t": "p",
          "text": "يسير هذا النظام من <b>الأعم إلى الأخص</b>: الشيء الأساسي، ثم الكمية، ثم المالك، ثم الوظيفة في الجملة."
        },
        {
          "t": "note",
          "kind": "info",
          "tag": "اسمان مرتبطان",
          "text": "<b>حالة الإضافة</b> (<tur>-in</tur>) تربط اسمين: توضع على <b>المالك</b>، وتوضع <b>لاحقة الملكية</b> على الشيء المملوك. <tur>evin kapısı</tur> = باب البيت (<tur>ev-in</tur> + <tur>kapı-sı</tur>). وحالة الإضافة تُنهي الكلمة الأولى؛ ولا تدخل في الترتيب الداخلي للكلمة الثانية."
        },
        {
          "t": "note",
          "kind": "tip",
          "tag": "دليل",
          "text": "حين ترى كلمة تركية طويلة، لا تفزع: فكّكها من اليمين. ابحث عن -ler/-lar (الجمع)، ثم عن لاحقة تعرفها. وقراءة «تقشير البصلة» تجعل 90% من الكلمات الطويلة واضحة."
        }
      ],
      "dialogue": {
        "title": "في السوق",
        "lines": [
          {
            "name": "Magloire",
            "tr": "Merhaba! Üç tane elma ve iki ekmek, lütfen.",
            "fr": "صباح الخير! ثلاث تفاحات ورغيفا خبز، من فضلك."
          },
          {
            "name": "Esnaf",
            "tr": "Buyurun. Başka bir şey ister misiniz?",
            "fr": "تفضل. هل تريد شيئًا آخر؟"
          },
          {
            "name": "Magloire",
            "tr": "Domatesler güzel mi?",
            "fr": "هل الطماطم جيدة؟"
          },
          {
            "name": "Esnaf",
            "tr": "Çok taze! Sabah geldiler.",
            "fr": "طازجة جدًا! وصلت هذا الصباح."
          },
          {
            "name": "Magloire",
            "tr": "O zaman beş tane domates de alın.",
            "fr": "إذن آخذ خمس طماطمات أيضًا."
          },
          {
            "name": "Esnaf",
            "tr": "Hepsi yirmi lira. Afiyet olsun!",
            "fr": "المجموع عشرون ليرة. بالهناء والشفاء!"
          }
        ]
      },
      "vocab": [
        {
          "tr": "tane",
          "fr": "قطعة (أداة عد)"
        },
        {
          "tr": "başka",
          "fr": "آخر"
        },
        {
          "tr": "taze",
          "fr": "طازج"
        },
        {
          "tr": "sabah",
          "fr": "صباح"
        },
        {
          "tr": "hepsi",
          "fr": "كل، المجموع"
        },
        {
          "tr": "market / pazar",
          "fr": "سوبرماركت / سوق"
        },
        {
          "tr": "almak",
          "fr": "يأخذ، يشتري"
        },
        {
          "tr": "istemek",
          "fr": "يريد"
        }
      ],
      "quiz": [
        {
          "q": "ماذا تعني « evlerimde »؟",
          "opts": [
            "بيوتي",
            "في بيوتي",
            "بيتك",
            "البيوت البعيدة"
          ],
          "a": 1,
          "exp": "ev-ler-im-de: بيت + جمع + ملكية المتكلم + في = في بيوتي."
        },
        {
          "q": "«في بيتي» تُقال…",
          "opts": [
            "evlerde",
            "evimde",
            "evlerimde",
            "evim"
          ],
          "a": 1,
          "exp": "ev-im-de: بيت + ملكية المتكلم + في. وبدون الجمع، تعني evlerimde «في بيوتي»."
        },
        {
          "q": "جمع « şehir » (مدينة)؟",
          "opts": [
            "şehirler",
            "şıhırlar",
            "şehirlar",
            "şehirlor"
          ],
          "a": 0,
          "exp": "i (صائت أمامي) ← -ler: şehirler."
        },
        {
          "q": "بعد العدد (مثل üç elma)، يكون الاسم…",
          "opts": [
            "دائمًا في الجمع",
            "في المفرد",
            "في المثنى",
            "في حالة المكان"
          ],
          "a": 1,
          "exp": "üç elma، beş kitap: العدد يكفي، ولا جمع بعد الرقم."
        },
        {
          "q": "الترتيب الصحيح للواحق هو…",
          "opts": [
            "الحالة ← الجمع ← الملكية",
            "الملكية ← الحالة ← الجمع",
            "الجمع ← الملكية ← الحالة",
            "لا يهم"
          ],
          "a": 2,
          "exp": "دائمًا: الجمع ← الملكية ← الحالة (ev-ler-im-de)."
        },
        {
          "q": "جمع « çocuk » (طفل)؟",
          "opts": [
            "çocukler",
            "çocuklar",
            "çocuklir",
            "çocuklor"
          ],
          "a": 1,
          "exp": "u/o = صائت خلفي ← -lar: çocuklar."
        }
      ]
    },
    {
      "id": "m6",
      "num": 6,
      "level": "A2",
      "title": "العائلة والملكية",
      "subtitle": "بيتي وبيتك وبيته: لواحق من جديد",
      "objectifs": [
        "تقديم أفراد عائلتك",
        "التعبير عن الملكية باللواحق",
        "السؤال بـ«لمن؟» و«ما هذا؟»"
      ],
      "blocks": [
        {
          "t": "p",
          "text": "في لغات كثيرة تُعبَّر الملكية بكلمات مستقلة (مثل: بيتي، بيتك، بيته). أما في التركية فتستخدم <b>لواحق</b> تُلصق بالاسم المملوك، مع تناغمها الصوتي بالطبع."
        },
        {
          "t": "table",
          "caption": "لواحق الملكية",
          "head": [
            "الشخص",
            "اللاحقة",
            "مثال مع « anne » (أم)",
            "الترجمة"
          ],
          "rows": [
            [
              "المفرد المتكلم (ـي)",
              "-im",
              "<tur>annem</tur>",
              "أمي"
            ],
            [
              "المفرد المخاطب (ـك)",
              "-in",
              "<tur>annen</tur>",
              "أمك"
            ],
            [
              "المفرد الغائب (ـه)",
              "-i",
              "<tur>annesi</tur>",
              "أمه"
            ],
            [
              "جمع المتكلم (ـنا)",
              "-imiz",
              "<tur>annemiz</tur>",
              "أمنا"
            ],
            [
              "جمع المخاطب (ـكم)",
              "-iniz",
              "<tur>anneniz</tur>",
              "أمكم"
            ],
            [
              "جمع الغائب (ـهم)",
              "-leri",
              "<tur>anneleri</tur>",
              "أمهم"
            ]
          ]
        },
        {
          "t": "note",
          "kind": "warn",
          "tag": "حرف الوصل n",
          "text": "إذا انتهت الكلمة بصائت، يُدخل <b>n</b> وصلًا في الشخص الثالث: <tur>araba</tur> (سيارة) → araba<b>sı</b> (سيارته)، <tur>oda</b> → oda<b>sı</b> (غرفته). وفي الأشخاص الأخرى تُستعمل y: araba<b>m</b>… لا: araba + -m → araba<b>m</b> (سيارتي، مباشرة)، oda<b>m</b>. واحفظ خاصة <b>-sı/-si</b> للشخص الثالث، فهي كثيرة الشيوع."
        },
        {
          "t": "h",
          "text": "تقديم العائلة"
        },
        {
          "t": "ex",
          "items": [
            {
              "tr": "Ailem büyük.",
              "fr": "عائلتي كبيرة."
            },
            {
              "tr": "İki kardeşim var.",
              "fr": "لديّ اثنان من الإخوة."
            },
            {
              "tr": "Annem öğretmen, babam mühendis.",
              "fr": "أمي معلمة وأبي مهندس."
            },
            {
              "tr": "Ablam İzmir'de yaşıyor.",
              "fr": "أختي الكبرى تسكن في إزمير."
            },
            {
              "tr": "Bu kim? : Bu ablam.",
              "fr": "من هذه؟: هذه أختي الكبرى."
            }
          ]
        },
        {
          "t": "p",
          "text": "تميّز التركية تمييزًا دقيقًا بين أفراد العائلة: <tur>abla</tur> = الأخت الكبرى، <tur>abi</tur> = الأخ الأكبر، <tur>kız kardeş</tur> = الأخت الصغرى، <tur>erkek kardeş</tur> = الأخ الأصغر. كما تُستعمل « abla » و« abi » بأدب مع الغرباء الأكبر سنًّا!"
        },
        {
          "t": "note",
          "kind": "info",
          "tag": "للملاحظة",
          "text": "للقول «اسم أمي»، نستخدم حالة الإضافة: <tur>annemin adı</tur> (annem-in ad-ı) = حرفيًا «أمي-اسمها». لاحقتان تتسلسلان: فالملكية في التركية <b>انعكاسية</b>: يحمل الشيء المملوك أيضًا علامة مالكه."
        }
      ],
      "dialogue": {
        "title": "صور عائلية",
        "lines": [
          {
            "name": "Elif",
            "tr": "Bu fotoğrafa bak! Ailem bu.",
            "fr": "انظر إلى هذه الصورة! هذه عائلتي."
          },
          {
            "name": "Magloire",
            "tr": "Çok güzel! Bu kim?",
            "fr": "جميلة جدًا! من هذه؟"
          },
          {
            "name": "Elif",
            "tr": "Bu ablam. Adı Zeynep.",
            "fr": "هذه أختي الكبرى. اسمها زينب."
          },
          {
            "name": "Magloire",
            "tr": "Peki bu? Çocuk çok tatlı.",
            "fr": "وذاك؟ الطفل لطيف جدًا."
          },
          {
            "name": "Elif",
            "tr": "Yeğenim! Ablamın oğlu.",
            "fr": "إنه ابن أختي! ابن أختي الكبرى."
          },
          {
            "name": "Magloire",
            "tr": "Kaç yaşında?",
            "fr": "كم عمره؟"
          },
          {
            "name": "Elif",
            "tr": "Beş yaşında. Çok yaramaz!",
            "fr": "خمس سنوات. كثير الحركة!"
          }
        ]
      },
