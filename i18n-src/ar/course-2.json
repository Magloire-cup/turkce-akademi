          {
            "name": "Resepsiyon",
            "tr": "Evet, var. Wi-Fi de var.",
            "fr": "نعم، يوجد. ويوجد أيضًا Wi-Fi."
          },
          {
            "name": "Magloire",
            "tr": "Peki balkon var mı?",
            "fr": "وهل توجد شرفة؟"
          },
