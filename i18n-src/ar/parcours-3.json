              "<tur>en güzel</tur>",
              "الأجمل"
            ],
            [
              "kadar",
              "<tur>senin kadar hızlı</tur>",
              "سريع بقدرك"
            ],
            [
              "حالة الابتداء + daha",
              "<tur>Ali'den daha uzun</tur>",
              "أطول من علي"
            ]
          ]
        },
        {
          "t": "p",
          "text": "للنصيحة يمكن استخدام <tur>bence</tur> (في رأيي)، و<tur>-meli</tur> (يجب عليك)، و<tur>istersen</tur> (إن أردت): <tur>Bence dinlenmelisin.</tur> (في رأيي، يجب أن ترتاح.)، <tur>İstersen yardım edebilirim.</tur> (إن أردت، يمكنني المساعدة.)."
        },
        {
          "t": "note",
          "kind": "info",
          "tag": "الضمائر غير المحددة",
          "text": "<tur>herkes</tur> (الجميع)، <tur>kimse</tur> (لا أحد)، <tur>hiç kimse</tur> (لا أحد على الإطلاق)، <tur>bir şey</tur> (شيء ما)، <tur>hiçbir şey</tur> (لا شيء)، <tur>her şey</tur> (كل شيء)، <tur>bazıları</tur> (بعضهم)."
        },
        {
          "t": "ex",
          "items": [
            {
              "tr": "Bugün daha iyiyim.",
              "fr": "أشعر بتحسن اليوم."
